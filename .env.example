# Copy to .env.local and fill in. Never commit real keys.

# LLM for the analyst and creative agents. Without it the app still works:
# reports fall back to rule-based text, creative generation is disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Meta Marketing API (read-only insights sync). Optional; CSV import works without it.
META_ACCESS_TOKEN=
META_API_VERSION=v25.0

# Where the SQLite file lives (default: ./data/marketing.db)
DB_PATH=
